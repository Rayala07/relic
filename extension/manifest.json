{
  "manifest_version": 3,
  "name": "Relic",
  "version": "1.0.0",
  "description": "Save any page to your Relic collection in one click.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Relic"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://relic-backend-server.onrender.com/*"
  ]
}
